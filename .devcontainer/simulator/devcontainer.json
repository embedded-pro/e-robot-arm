{
  // The simulator, the console and the host tests, without access to the host's devices or Docker daemon.
  // For boards, debug probes and CAN adapters, use the default Dev Container.
  "name": "e-robot-arm simulator",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  // The simulator window needs an X server on the host.
  //   Windows: install VcXsrv or X410, launch with "Disable access control" enabled.
  //   macOS:   install XQuartz, enable "Allow connections from network clients" in Preferences > Security.
  //   Linux:   run 'xhost +local:docker' to allow container access.
  "containerEnv": {
    "DISPLAY": "host.docker.internal:0.0",
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "DEBUGINFOD_URLS": ""
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--shm-size=256m"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "matepek.vscode-catch2-test-adapter@4.12.2",
        "anthropic.claude-code@2.1.162"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true
      }
    }
  },
  "postCreateCommand": {
    "submodule.update": "git submodule update --init --recursive",
    "config.core.autocrlf": "git config --replace-all core.autocrlf false",
    "config.core.eol": "git config --replace-all core.eol lf"
  }
}
